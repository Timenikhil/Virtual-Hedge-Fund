# ---------------------------------------------------------------------------
# Virtual Hedge Fund — environment variable reference
# Copy this file to .env and fill in your values.
# Never commit your real .env to version control.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database (libSQL / Turso)
# ---------------------------------------------------------------------------
DB_URL=libsql://your-db-name.turso.io
DB_TOKEN=your-turso-auth-token

# ---------------------------------------------------------------------------
# Admin API authentication
# All /api/v1/admin/* endpoints require:  X-API-Key: <ADMIN_API_KEY>
# ---------------------------------------------------------------------------
ADMIN_API_KEY=change-me-before-deploying

# ---------------------------------------------------------------------------
# AI weight allocator
# Mode: auto | local | remote | disabled  (default: auto)
#   auto     — tries local (Claude API) first, then remote, then disabled
#   local    — calls Anthropic Claude API directly (requires ANTHROPIC_API_KEY)
#   remote   — POSTs portfolio context to AI_ALLOCATOR_URL
#   disabled — skips AI; falls back to equal_weight
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
AI_ALLOCATOR_MODE=auto

# Model override for weight allocation and selectors (default: claude-sonnet-4-6)
# AI_WEIGHT_ALLOCATOR_MODEL=claude-sonnet-4-6

# Remote allocator endpoint (required when AI_ALLOCATOR_MODE=remote)
# AI_ALLOCATOR_URL=https://your-allocator-service/allocate
# AI_ALLOCATOR_API_KEY=your-remote-service-key

# Custom local allocator module/function (rarely needed)
# AI_ALLOCATOR_LOCAL_MODULE=vhf.ai.ai_weight_allocator
# AI_ALLOCATOR_LOCAL_FUNCTION=allocate_weights

# ---------------------------------------------------------------------------
# Reconcile scheduler
# ---------------------------------------------------------------------------
# Set to false/0 to disable the background scheduler entirely
RECONCILE_SCHEDULER_ENABLED=true

# How often the scheduler polls for due jobs (seconds, default: 86400 = 1 day)
RECONCILE_SCHEDULER_POLL_SECONDS=86400

# Worker identity used for distributed locking (default: hostname:pid)
# RECONCILE_SCHEDULER_WORKER_ID=worker-1

# ---------------------------------------------------------------------------
# QuantRocket
# ---------------------------------------------------------------------------
# Path to docker-compose file used to invoke QuantRocket CLI
# QUANTROCKET_COMPOSE_FILE=docker-compose.yml

# Maximum size of QuantRocket CLI stdout before raising an error (bytes, default: 52428800 = 50 MB)
# QUANTROCKET_MAX_OUTPUT_BYTES=52428800

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins (default: http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Observability / logging
# ---------------------------------------------------------------------------
LOG_FILE_PATH=./logs/app.log
LOKI_URL=https://logs-prod-020.grafana.net/loki/api/v1/push
LOKI_USERNAME=
LOKI_PASSWORD=
