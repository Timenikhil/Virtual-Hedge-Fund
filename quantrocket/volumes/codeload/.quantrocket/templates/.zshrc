# .zshrc (Z-Shell run commands file)
#
# This file can be used to create shortcuts to commonly used commands.
# For more information, see http://qrok.it/p/zshrc. After making changes,
# you must open a new Terminal for the changes to take effect. All example
# commands are currently commented out.

# View account balance
# alias balance="quantrocket account balance -l -f NetLiquidation | csvlook"

# run myfunction in /codeload/scripts/myscript.py
# alias myscript="quantrocket satellite exec codeload.scripts.myscript.myfunction"

# run myfunction in /codeload/scripts/myscript.py and pass an argument
# function myscript {
#     quantrocket satellite exec codeload.scripts.myscript.myfunction --params myparam:$1
# }
